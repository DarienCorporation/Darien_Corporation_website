# Public site URL, used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com

# Public contact email shown on the site. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public social profiles. Leave empty to hide them. Only add real accounts.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_GITHUB=

# Contact form delivery (server-only, never exposed to the browser).
# The form is only shown when both values are set.
RESEND_API_KEY=
CONTACT_FORM_TO=
# Verified sender address in Resend, e.g. "Darien Website <website@yourdomain>"
CONTACT_FORM_FROM=

# Header your hosting platform sets with the real client IP (used for rate limiting).
# Vercel: x-vercel-forwarded-for · Cloudflare: cf-connecting-ip · Leave empty if unsure.
TRUSTED_IP_HEADER=

# Admin area (server-only). Generate with: npm run admin:setup
# If any of these are missing, /admin is disabled and returns 404.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_VERSION=
